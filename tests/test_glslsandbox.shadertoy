// GLSLSandbox-style source: uniform time/resolution declarations rather than
// a JSON manifest and without mainImage.
uniform float time;
uniform vec2 resolution;

void main() {
    vec2 uv = gl_FragCoord.xy / resolution.xy;
    float w = 0.5 + 0.5 * sin(time * 2.0 + uv.x * 6.0);
    gl_FragColor = vec4(vec3(w), 1.0);
}
